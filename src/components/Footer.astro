---
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="footer-content">
		<p>&copy; {currentYear} Song Yuyang. All rights reserved.</p>
		<a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">
			皖ICP备2026001220号-3
		</a>
	</div>
</footer>

<style>
	footer {
		width: 100%;
		margin-top: auto;
		color: rgb(var(--gray));
		font-size: 0.8rem;
	}

	.footer-content {
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: min(720px, calc(100% - 4rem));
		margin: 0 auto;
		padding: 1.5rem 0;
		border-top: 1px solid rgba(var(--gray), 18%);
	}

	p {
		margin: 0;
	}

	a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 560px) {
		.footer-content {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
			width: calc(100% - 3rem);
			padding: 1.25rem 0;
		}
	}
</style>
