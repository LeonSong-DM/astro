---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type BlogData = CollectionEntry<'blog'>['data'];
type Props = Omit<BlogData, 'city'> & { city?: string };

const { title, description, pubDate, updatedDate, heroImage, city } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: clamp(720px, 33.333vw, 1080px);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
				font-size: 15px;
			}
			.title {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				align-items: center;
				gap: 1.25rem;
				margin-bottom: 1em;
				padding: 0.5em 0;
				text-align: left;
			}
			.title h1 {
				margin: 0;
				font-size: 1.333em;
				line-height: 1.25;
			}
			.metadata {
				padding-left: 1.25rem;
				border-left: 1px solid rgb(var(--gray-light));
				text-align: right;
			}
			.post-meta {
				display: flex;
				align-items: baseline;
				justify-content: flex-end;
				gap: 0.75rem;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1em;
				line-height: 1.5;
			}
			.last-updated-on {
				margin-top: 0.25em;
				color: rgb(var(--gray));
				font-size: 1em;
				font-style: italic;
			}
			.article-divider {
				margin: 0 0 1em;
			}
			.content :global(h1),
			.content :global(h2),
			.content :global(h3),
			.content :global(h4) {
				margin: 2em 0 0.75em;
				line-height: 1.35;
				letter-spacing: -0.015em;
			}
			.content :global(h1) {
				font-size: 1.6em;
			}
			.content :global(h2) {
				font-size: 1.35em;
			}
			.content :global(h3) {
				font-size: 1.15em;
			}
			.content :global(h4) {
				font-size: 1.05em;
			}
			@media (max-width: 800px) {
				.prose {
					width: calc(100% - 2em);
					max-width: none;
				}
				.title {
					grid-template-columns: 1fr;
					gap: 0.5em;
				}
				.metadata {
					padding: 0.5em 0 0;
					border-top: 1px solid rgb(var(--gray-light));
					border-left: 0;
					text-align: left;
				}
				.post-meta {
					justify-content: flex-start;
					flex-wrap: wrap;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="metadata">
							<div class="post-meta">
								<FormattedDate date={pubDate} />
								{city && <span>{city}</span>}
							</div>
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
					</div>
					<hr class="article-divider" />
					<div class="content">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
